@@ -0,0 +1,49 @@
+# HIPAA Readiness Checklist
+
+## Status and scope
+
+This public repository is a **demonstration prototype**. It is not approved to
+create, receive, maintain, or transmit electronic protected health information
+(ePHI), and this checklist is not a certification of HIPAA compliance.
+
+The prototype currently reduces privacy risk by requiring demo mode, removing
+direct-identifier fields from the intake interface, labeling records as
+synthetic, ignoring local databases and secrets in Git, and testing its privacy
+guardrails in CI.
+
+## Required before any ePHI use
+
+- [ ] Determine whether the operator is a covered entity or business associate.
+- [ ] Complete and document an organization-wide HIPAA security risk analysis.
+- [ ] Approve a risk-management plan and assign a security official.
+- [ ] Establish Privacy, Security, Breach Notification, sanctions, training,
+      incident-response, contingency, backup, disaster-recovery, retention, and
+      disposal policies.
+- [ ] Execute Business Associate Agreements with every service provider that
+      creates, receives, maintains, or transmits ePHI.
+- [ ] Select a HIPAA-eligible managed database and services covered by signed
+      BAAs; do not assume that a service is compliant merely because it offers
+      eligible products.
+- [ ] Replace local SQLite ePHI storage with the approved managed database.
+- [ ] Implement unique user accounts, MFA, role-based least privilege,
+      authorization checks, emergency access, automatic logoff, and session
+      revocation.
+- [ ] Implement encryption in transit and at rest with managed keys, rotation,
+      restricted key access, and documented recovery procedures.
+- [ ] Implement tamper-resistant audit logging for access, exports, changes,
+      authentication events, administrator actions, and disclosures; exclude
+      clinical content and secrets from logs.
+- [ ] Define minimum-necessary data collection, retention periods, deletion,
+      data-subject workflows, and approved de-identification procedures.
+- [ ] Perform vulnerability scanning, dependency review, penetration testing,
+      backup restoration tests, incident exercises, and access reviews.
+- [ ] Complete legal, privacy, security, and clinical safety review before
+      production authorization.
+
+## Authoritative references
+
+- HHS, Security Rule: https://www.hhs.gov/hipaa/for-professionals/security/
+- HHS, Risk Analysis Guidance: https://www.hhs.gov/hipaa/for-professionals/security/guidance/guidance-risk-analysis/
+- HHS, Technical Safeguards: https://www.hhs.gov/sites/default/files/ocr/privacy/hipaa/administrative/securityrule/techsafeguards.pdf
+- HHS, Business Associates: https://www.hhs.gov/hipaa/for-professionals/privacy/guidance/business-associates/
+- HHS, Cloud Computing: https://www.hhs.gov/hipaa/for-professionals/special-topics/health-information-technology/cloud-computing/
diff --git a/privacy_guard.py b/privacy_guard.py
new file mode 100644
index 0000000..b06c4a4
--- /dev/null
+++ b/privacy_guard.py
@@ -0,0 +1,40 @@
+"""Privacy guardrails for the public SafeHaven demonstration prototype."""
+
+from __future__ import annotations
+
+import os
+import re
+from datetime import date
+
+
+DEMO_MODE_ENV = "SAFEHAVEN_DEMO_MODE"
+_SAFE_ID = re.compile(r"^[A-Za-z0-9_-]{3,24}$")
+
+
+def require_demo_mode() -> None:
+    """Fail closed unless this public prototype explicitly runs in demo mode."""
+    if os.getenv(DEMO_MODE_ENV, "true").strip().lower() not in {
+        "1",
+        "true",
+        "yes",
+    }:
+        raise RuntimeError(
+            "This repository is demo-only and cannot process real health data."
+        )
+
+
+def demo_alias(participant_id: str) -> str:
+    """Return a clearly synthetic identifier without accepting free-form PII."""
+    value = participant_id.strip()
+    if not _SAFE_ID.fullmatch(value):
+        raise ValueError(
+            "Use 3-24 letters, numbers, underscores, or hyphens only."
+        )
+    return f"DEMO-{value.upper()}"
+
+
+def approximate_birth_date(age: int, today: date) -> date:
+    """Generate a non-exact date for a synthetic 18-24-year-old record."""
+    if not 18 <= age <= 24:
+        raise ValueError("Demo age must be between 18 and 24.")
+    return date(today.year - age, 1, 1)
diff --git a/tests/test_privacy_guard.py b/tests/test_privacy_guard.py
new file mode 100644
index 0000000..5daeef9
--- /dev/null
+++ b/tests/test_privacy_guard.py
@@ -0,0 +1,38 @@
+import os
+import unittest
+from datetime import date
+from unittest.mock import patch
+
+from privacy_guard import approximate_birth_date, demo_alias, require_demo_mode
+
+
+class TestPrivacyGuard(unittest.TestCase):
+    def test_demo_mode_defaults_to_enabled(self):
+        with patch.dict(os.environ, {}, clear=True):
+            require_demo_mode()
+
+    def test_non_demo_mode_fails_closed(self):
+        with patch.dict(os.environ, {"SAFEHAVEN_DEMO_MODE": "false"}):
+            with self.assertRaises(RuntimeError):
+                require_demo_mode()
+
+    def test_identifier_is_marked_synthetic(self):
+        self.assertEqual(demo_alias("test-001"), "DEMO-TEST-001")
+
+    def test_free_form_identifier_is_rejected(self):
+        with self.assertRaises(ValueError):
+            demo_alias("Jane Doe (213) 555-0100")
+
+    def test_birth_date_is_approximate(self):
+        self.assertEqual(
+            approximate_birth_date(20, date(2026, 9, 7)),
+            date(2006, 1, 1),
+        )
+
+    def test_age_outside_tay_range_is_rejected(self):
+        with self.assertRaises(ValueError):
+            approximate_birth_date(25, date(2026, 9, 7))
+
+
+if __name__ == "__main__":
+    unittest.main()
